# OpenRouter (recommended — no waitlist, billed to OpenRouter account)
OPENROUTER_API_KEY=sk-or-v1_REPLACE_ME
JEV_MODEL=typesafe/jev-1.13
# Provider: openrouter (default when key set), hosted proxy, or ollama (local, free)
# JEV_PROVIDER=openrouter

# Local Ollama decision model (used when JEV_PROVIDER=ollama)
# OLLAMA_MODEL=tev1:latest
# OLLAMA_ENDPOINT=http://localhost:11434
# Optional: override endpoint (Decisions API default)
# JEV_ENDPOINT=https://openrouter.ai/api/alpha/decisions

# Alternative: TypeSafe direct (https://console.typesafe.ai)
# TYPESAFE_API_KEY=ts_REPLACE_ME
# TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone

# Alternative: hosted proxy
# JEV_API_KEY=jv_live_REPLACE_ME
# JEV_ENDPOINT=https://jevtypesafeai.com/api/v1/decide
PORT=3000
